############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "contextForm.pl",
  "contextFiniteSolutionSets.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
$var = list_random('a'..'n','p'..'z','A'..'N','P'..'T','V'..'Z');
Context()->variables->are($var => 'Real');
($a, $b) = (0..10)[NchooseK(11,2)];
($a, $b) = map{$_ + random(0.1, 0.9, 0.1)} ($a, $b);
$b = random(0,1) ? $b : -$b;
$left = Formula("$a $var")->reduce;
$right = Formula("$b")->reduce;
Context("FiniteSolutionSets");
Context()->flags->remove("NumberCheck");
Context()->variables->are($var => 'Real');
$solution = $b/$a;
$solset = Formula("{$solution}");

############################################################
# Body
############################################################

BEGIN_PGML
Solve the equation.

[`[$left]=[$right]`]

[_]{$solset}{10}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
