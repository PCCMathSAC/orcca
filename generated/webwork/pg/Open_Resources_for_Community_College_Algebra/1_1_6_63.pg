DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserNumberWithUnits.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
$h = random(2, 24, 1);
$s = NumberWithUnits(3600*$h, 'seconds');
# Make units parser require seconds, not allow hours
$evaluator = $s->cmp(mathQuillOpts => 'disabled')->withPostFilter(sub {
  my $ans = shift;
  if ($ans->{score}) {
    my $correct = $ans->{correct_value};
    my $student = $ans->{student_value};
    my %goodunits = map { $_ => 1 } ('s', 'sec', 'second', 'seconds');
    if (!exists($goodunits{$student->{units}})) {
      $ans->{ans_message} = "Your answer is equivalent to the correct answer, but it uses the wrong units";
      $ans->score(0);
    }
  }
  return $ans;
});

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
There is a formula to convert a number of hours into so many seconds: [`s=3600h\text{.}`]

END_PGML

######
# Body
######

BEGIN_PGML
How much time is [`[$h]`] hours in seconds?

[_]{$evaluator}{12}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
