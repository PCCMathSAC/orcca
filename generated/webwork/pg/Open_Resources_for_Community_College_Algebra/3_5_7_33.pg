DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction")->variables->add(y=>'Real');
($m, $b) = random_subset(2, 2..5);
$b = list_random($b, -$b);
$m = Fraction(-1/$m);
Context()->noreduce('(-x)+y','(-x)-y');
parser::Assignment->Allow;
$equation = Formula("y = $m x + $b")->reduce;
$gt = GraphTool("{line, solid, (0, $b), (1/$m, $b + 1)}")->with(
  bBox => [-11, 11, 11, -11],
  availableTools => [ "LineTool" ],
  showInStatic => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Graph the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$equation]`]

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

