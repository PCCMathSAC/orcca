DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGlateximage.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
($m, $b) = random_subset(2, 2..5);
$b = list_random($b, -$b);
$m = -$m;
Context("Numeric")->variables->add(y=>'Real');
Context()->noreduce('(-x)+y','(-x)-y');
parser::Assignment->Allow;
$equation = Formula("y = $m x + $b")->reduce;
$gt = GraphTool("{line, solid, (0, $b), (1, $b + $m)}")->with(
  bBox => [-11, 11, 11, -11],
  availableTools => [ "LineTool" ],
  showInStatic => 0,
);
$l = max(-10, (10 - $b)/$m);
$r = min(10, (-10 - $b)/$m);
$image_1 = createLaTeXImage();
$image_1->addToPreamble(latexImagePreamble());
$image_1->BEGIN_LATEX_IMAGE
\begin{tikzpicture}
  \begin{axis}
    \addplot[domain=$l:$r] {$m*x + $b};
  \end{axis}
\end{tikzpicture}

END_LATEX_IMAGE

############################################################
# Body
############################################################

BEGIN_PGML
Use the slope and [`y`]-intercept to plot the line.

[`[$equation]`]

[_]{$gt}{1}


END_PGML

############################################################
# Solution
############################################################

BEGIN_PGML_SOLUTION
[#
    [.
        Start the plot at the [`y`]-intercept [`(0,[$b])\text{.}`] Then use slope triangles with slope [`[$m]`] to extend a line in two directions.
    .]
    [.
        [@image(insertGraph($image_1), width=>282)@]* 
    .]*
#]*{align => 'p{47%}p{47%}',}


END_PGML_SOLUTION

############################################################
# End Problem
############################################################

ENDDOCUMENT();
