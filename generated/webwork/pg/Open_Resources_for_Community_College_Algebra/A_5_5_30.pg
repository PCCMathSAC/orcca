loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
$grouping = list_random(['(',')'],['[',']']);
($answer,$c) = (3..9)[NchooseK(7,2)];
$aminusb = $answer*$c;
$b = random(1,5,1);
$a = $aminusb + $b;
Context("LimitedNumeric");
$answer = Real(($a-$b)/$c);

############################################################
# Body
############################################################

BEGIN_PGML
Use the order of operations to simplify the expression that has grouping symbols.

[`[$grouping->[0]][$a] - [$b][$grouping->[1]] \div [$c]`]

[_]{$answer}{5}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
