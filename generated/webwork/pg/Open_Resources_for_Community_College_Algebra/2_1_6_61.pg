#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserNumberWithUnits.pl",
  "randomPerson.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
$name = randomPerson();
$initial = 425;
$rate = random(20,30);
$final = random(200,300,25);
$solution = -($final - $initial)/$rate;
$time = NumberWithUnits("$solution min");

######
# Body
######

BEGIN_PGML
[$name] baked a pie at [`[$initial]\,^{\circ}F`] and just took it out of the oven. It immediately starts to cool at a rate of [`[$rate]\,\frac{^{\circ}F}{\text{min}}\text{.}`] How long will it take to cool to [`[$final]\,^{\circ}F\text{?}`]

[_]{$time}{20}

END_PGML

