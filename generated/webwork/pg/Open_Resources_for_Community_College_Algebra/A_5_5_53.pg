#######
# Setup
#######

$n = random(1,10,1);
$b = random(1,9,1);
$a = $n**2 - $b;
$c = ($n+1)**2 - $n**2;
Context("LimitedNumeric");
$answer = Real(sqrt($a+$b)+$c);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Use the order of operations to simplify the expression that has absolute value or implied grouping.

END_PGML

######
# Body
######

BEGIN_PGML
[`\sqrt{[$a]+[$b]}+[$c]`]

[_]{$answer}{5}

END_PGML

