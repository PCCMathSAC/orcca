COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context()->variables->are(n => 'Real');
$b = random(250, 400, 10);
$r = random(100, 200, 5);
$expression = Formula("$b + $r n");
Context("Currency");
Context()->flags->set(trimTrailingZeros => 1);
$base = Currency($b);
$rate = Currency($r);

######
# Body
######

BEGIN_PGML
The rental fee for a beach house is a flat [`[$base]`] plus [`[$rate]`] per night. Write an expression for the cost to rent the beach house for [`n`] nights.

[_]{$expression}{20}

END_PGML

