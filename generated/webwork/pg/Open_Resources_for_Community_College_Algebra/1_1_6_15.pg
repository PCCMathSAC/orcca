#######
# Setup
#######

$x = list_random('a'..'d', 'f'..'h', 'j'..'n', 'p'..'z');
Context()->variables->are($x => 'Real');
($m, $b, $a) = (2..9)[NchooseK(8, 3)];
$a = -$a;
$expression = Formula("$m $x + $b");
Context("LimitedNumeric");
$r = Real($expression->eval($x => $a));

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$expression]`] for [`[$x]=[$a]`]

[_]{$r}{10}

END_PGML

