DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Form");
$var = list_random('a'..'n', 'p'..'z', 'A'..'D', 'F'..'N', 'P'..'T', 'V'..'Z');
Context()->variables->are($var => 'Real');
($a, $b, $c, $d) = (2..9)[NchooseK(8,4)];
$given = Formula("$d + $a ($b $var - $c)");
$ab = $a*$b;
$acd = $d - $a*$c;
$ans = Formula("$ab $var + $acd");
$sol[0] = Formula("$d + ($a*$b) $var - ($a*$c)")->reduce;

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Simplify the given expression. Ideally, you are thinking about how the properties of algebra are helping you simplify.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$given]`]

[_]{$ans}{16}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
First, apply the distributive property to get [`[$sol[0]]\text{.}`] Now add the two like terms to get [`[$ans]\text{.}`]

END_PGML_SOLUTION

#############
# End Problem
#############

ENDDOCUMENT();
