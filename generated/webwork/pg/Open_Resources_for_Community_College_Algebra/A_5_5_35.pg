COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$grouping = list_random(['(',')'],['[',']']);
$c = 2;
$ab = list_random([2,3],[3,2],[2,5],[5,2],[2,2],[3,3],[2,4],[4,2]);
($a,$b) = @$ab;
Context("LimitedNumeric");
$answer = Real(($a*$b)**$c);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Use the order of operations to simplify the expression that has grouping symbols.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$grouping->[0]] [$a] \cdot [$b] [$grouping->[1]] ^{[$c]} `]

[_]{$answer}{5}

END_PGML

#############
# End Problem
#############

