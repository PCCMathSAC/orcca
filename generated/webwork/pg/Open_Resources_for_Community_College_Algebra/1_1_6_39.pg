DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$var = RandomVariableName();
Context()->variables->are($var => 'Real', solvar => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
$x = random(-9, -2);
$a = non_zero_random(-9, 9);
$b = random(-9, 9);
$c = random(-9, 9);
$expression = Formula("$a $var^2 + $b $var + $c")->reduce;
$answer = $expression->eval($var => $x);
$answer = Real($answer);
Context()->flags->set(reduceConstants => 0);
$sol[0] = $expression->substitute($var => Formula("$x"));
$sol[1] = $x**2;
$sol[2] = Formula("$a solvar + $b $var + $c")->reduce;
$sol[3] = $sol[2]->substitute($var => Formula("$x"), solvar => Formula("$sol[1]"));
$sol[4] = $a*$sol[1];
$sol[5] = $b*$x;
$sol[6] = Formula("solvar + $var + $c")->reduce;
$sol[7] = $sol[6]->substitute($var => Formula("$sol[5]"), solvar => Formula("$sol[4]"));
Context("LimitedNumeric");
$answer = Real($answer);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$expression]`] for [`[$var]=[$x]\text{.}`]

[_]{$answer}{15}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
Substitute [`[$x]`] in for the variable [`[$var]`] and simplify:

[```
\begin{aligned}
\amp[$sol[0]]\\
\amp=[$sol[3]]\\
\amp=[$sol[7]]\\
\amp=[$answer]
\end{aligned}
```]

END_PGML_SOLUTION

#############
# End Problem
