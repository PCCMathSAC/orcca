#######
# Setup
#######

$var = list_random('a'..'n','p'..'z','A'..'D', 'F'..'N','P'..'T','V'..'Z');
Context()->variables->are($var => 'Real');
($a, $b) = (2..20)[NchooseK(19,2)];
$b = random(0,1) ? $b : -$b;
$left = Formula("$var/$a")->reduce;
$right = Formula("$b")->reduce;
($left, $right) = ($left, $right)[NchooseK(2,2)];
Context("FiniteSolutionSets");
Context()->variables->are($var => 'Real');
$solution = $b*$a;
$solset = Formula("{$solution}");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[_]{$solset}{10}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
The opposite action to division is multiplication.

[```
\begin{aligned}
[$left] \amp= [$right]\\
\multiplyleft{[$a]}[$left] \amp= \multiplyleft{[$a]}[$right]\\
[$var] \amp= [$solution]
\end{aligned}
```]

The solution set is [`[$solset]\text{.}`]

END_PGML_SOLUTION

