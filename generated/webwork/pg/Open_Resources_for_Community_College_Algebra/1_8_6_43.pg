DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "parserFormulaWithUnits.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "parserLinearRelation.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
$rate = Fraction(random(1,11),12);
$speed = FormulaWithUnits("$rate ft");
$initial = random(4,6);
$final = random(10,12);
Context("LinearRelation")->variables->are(t => 'Real');
$equation = LinearRelation("$initial + $rate t = $final");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Write an equation to model the scenario. There is no need to solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
You planted a young tree in front of your house, and it was [`[$initial]`] feet tall. Ever since, it has been growing by [`[$speed]`] each year. How many years will it take for the tree to grow to be [$final] feet tall? Write an equation to model this scenario. There is no need to solve it.

[@KeyboardInstructions('Use [|t|]* as the variable.')@]**

[_]{$equation}{20}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
