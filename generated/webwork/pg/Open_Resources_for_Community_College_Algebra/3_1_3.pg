DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

@xy = random_subset(8, -8..-1,1..8);
@x = (@xy)[0..3];
@y = (@xy)[4..7];
@z = random_subset(2,0..3);
$x[$z[0]] = 0;
$y[$z[1]] = 0;
Context("Point");
@p = map {Point($x[$_], $y[$_])} (0..3);
$gt = GraphTool("{point,$p[0]}", "{point,$p[1]}", "{point,$p[2]}", "{point,$p[3]}")->with(
  availableTools => ['PointTool'],
  showInStatic => 0,
  showCoordinateHints => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Make a Cartesian plot with the indicated points marked.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$p[0]], [$p[1]], [$p[2]], [$p[3]]`]

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
