DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextFiniteSolutionSets.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
($m,$c) = random_subset(2,2..12);
$b = Fraction(random_coprime([1..12],[2..12]));
$left = Formula("$m x + $b");
$right = Formula("$c");
$sol = ($c - $b)/$m;
Context("FiniteSolutionSets");
$solution = Formula("{$sol}");
$lcd = ($b->value)[1];

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the given equation. Practice clearing the denominator(s) as a first step.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left] = [$right]`]

[@KeyboardInstructions('What LCD will you use?')@]**

[_]{$lcd}{4}

[@KeyboardInstructions('Solve the equation.')@]**

[_]{$solution}{16}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
