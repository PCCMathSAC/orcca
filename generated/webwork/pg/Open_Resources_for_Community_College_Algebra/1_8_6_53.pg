DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextCurrency.pl",
  "parserLinearRelation.pl",
  "randomPerson.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$name = randomPerson();
$initial = random(80,120,5);
Context("Currency")->flags->set(trimTrailingZeros => 1);
$start = Currency($initial);
$rate = random(12,18);
$speed = Currency($rate);
$final = $initial + $rate*random(12,23);
$end = Currency($final);
Context("LinearRelation")->variables->are(n => 'Real');
$equation = LinearRelation("$initial + $rate n = $final");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Write an equation to model the scenario. There is no need to solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
For [$name]'s 8th birthday party, [$name->possessive] parents rented a venue that charges a flat fee of [`[$start]`] plus [`[$speed]`] per guest. Ultimately it cost [$name]'s parents [`[$end]\text{.}`] How many guests were there? Write an equation to model this scenario. There is no need to solve it.

[@KeyboardInstructions('Use [|n|]* as the variable.')@]**

[_]{$equation}{20}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
