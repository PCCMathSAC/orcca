DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("LimitedFraction")->flags->set(allowMixedNumbers => 0, showMixedNumbers => 0);
do {
  @a = random_subset(8, -9 .. -1, 1 .. 9);
  @x = map {Fraction($a[$_], $a[$_ + 1])} (0, 2);
} until ($x[0] != $x[1]); 
@y = map {Fraction($a[$_], $a[$_ + 1])} (4, 6);
$A = Point($x[0], $y[0]);
$B = Point($x[1], $y[1]);
$m = ($y[1] - $y[0])/($x[1] - $x[0]);

######
# Body
######

BEGIN_PGML
Find the rate of change between the two given points.

[`[$A]`] and [`[$B]`]

[_]{$m}{5}

END_PGML

#############
# End Problem
#############

