TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
Context('Numeric');
$WL = list_random([3, 4], [6, 8], [5, 12], [9, 12], [8, 15], [12, 16], [15, 20], [7, 24], [10, 24], [20, 21], [18, 24], [16, 30], [21, 28]);
($W, $L) = @$WL;
$D = sqrt($L**2 + $W**2);

############################################################
# Body
############################################################

BEGIN_PGML
Determine the diagonal length of a rectangle with side lengths [`[$L]`] and [`[$W]\text{.}`]

[_]{$D}{10}


END_PGML

