DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

($m,$h,$k) = random_subset(3, 2..9);
Context("Form")->variables->add(y=>'Real');
Context()->noreduce('(-x)+y','(-x)-y');
parser::Assignment->Allow;
$eq = Formula("y=$m(x - $h) + $k")->reduce;
$p = Point($h,$k);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
A line passes through the given point with the given slope. Find an equation for the line in point-slope form using the given point.

END_PGML

######
# Body
######

BEGIN_PGML
through [`[$p]`] with slope [`[$m]`]

[_]{$eq}{16}

END_PGML

