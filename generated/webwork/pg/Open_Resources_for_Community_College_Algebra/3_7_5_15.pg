DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
$A = Fraction(random_coprime([1 .. 9], [2 .. 9]));
$B = Fraction(random_coprime([1 .. 9], [2 .. 9]));
$C = Fraction(random_coprime([1 .. 9], [2 .. 9]));
$x = $C/$A;
$y = $C/$B;
$m = -$y/$x;
Context()->variables->add(y => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
$left = Formula("$A x + $B y")->reduce;
$right = Formula("$C");
Context("Point");
$xi = Compute("($x,0)");
$yi = Compute("(0,$y)");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find both intercepts and the slope of the line.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[@KeyboardInstructions('Enter the [`x`]-intercept here.')@]**

[_]{$xi}{5}

[@KeyboardInstructions('Enter the [`y`]-intercept here.')@]**

[_]{$yi}{5}

[@KeyboardInstructions('Enter the slope here.')@]**

[_]{$m}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
