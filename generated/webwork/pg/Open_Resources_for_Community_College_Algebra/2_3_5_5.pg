loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
@b = random_pairwise_coprime([2..9],[2..9],[2..9]);
@a = ($b[1]*$b[2], $b[0]*$b[2], $b[0]*$b[1]);
$lcm = lcm(@a);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the Least Common Multiple of the given integers.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$a[0]]\text{,}`] [`[$a[1]]\text{,}`] and [`[$a[2]]`]

[_]{$lcm}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
