DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("LimitedFraction")->flags->set(allowMixedNumbers => 0, showMixedNumbers => 0);
$m = Fraction(random(-9, -1));
$b = non_zero_random(-9, 9);
@x = random_subset(2, 1 .. 9);
@y = map {$m*$_ + $b} (@x);
Context("Point");
@p = map {Point($x[$_], $y[$_])} (0,1);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the slope of the line passing through the two given points.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$p[0]]`] and [`[$p[1]]`]

[_]{$m}{10}

END_PGML

#############
# End Problem
#############

