#######
# Setup
#######

$h = non_zero_random(-9,9);
Context("Point");
$yi = Compute("none");
$xi = Compute("($h,0)");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the [`x`]\- and [`y`]-intercepts of each line.

END_PGML

######
# Body
######

BEGIN_PGML
[`x=[$h]`]

[@KeyboardInstructions('Enter the [`x`]-intercept here. If there is no [`x`]-intercept, enter [|none|]*.')@]**

[_]{$xi}{5}

[@KeyboardInstructions('Enter the [`y`]-intercept here. If there is no [`y`]-intercept, enter [|none|]*.')@]**

[_]{$yi}{5}

END_PGML

#############
# End Problem
#############

