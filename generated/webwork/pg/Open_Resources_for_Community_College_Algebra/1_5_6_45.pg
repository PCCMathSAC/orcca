DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFiniteSolutionSets.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
$var = list_random('a'..'n','p'..'z','A'..'D', 'F'..'N','P'..'T','V'..'Z');
Context()->variables->are($var => 'Real');
do {
  ($a, $b) = random_coprime([1..10], [2..10,12]);
  ($c, $d) = random_coprime([1..10], [2..10,12]);
} until ($b != $d);
$A = Fraction($a, $b);
$Ainv = 1/$A;
$B = Fraction($c, $d);
$B = random(0,1) ? $B : -$B;
$left = Formula("$A*$var")->reduce;
$right = Formula("$B")->reduce;
$solution = $B / $A;
Context("FiniteSolutionSets");
Context()->variables->are($var => 'Real');
$solset = Formula("{$solution}");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[_]{$solset}{10}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
To undo multiplication by a fraction, we can multiply my its reciprocal.

[```
\begin{aligned}
[$left] \amp= [$right]\\
\multiplyleft{[$Ainv]}[$left] \amp= \multiplyleft{[$Ainv]}[$right]\\
[$var] \amp= [$solution]
\end{aligned}
```]

The solution set is [`[$solset]\text{.}`]

END_PGML_SOLUTION

#############
# End Problem
#############

ENDDOCUMENT();
