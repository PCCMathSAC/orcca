DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Point");
$h = non_zero_random(-9,9);
@y = -2..2;
@x = ($h)x5;
@p = map {Point($x[$_],$y[$_])} (0..4);
$gt = GraphTool("{line,solid,$p[0],$p[1]}")->with(
  availableTools => [ "LineTool" ],
  showCoordinateHints => 0,
  showInStatic => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Use whatever method you think best to plot the line.

END_PGML

######
# Body
######

BEGIN_PGML
[`x=[$h]`]

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

