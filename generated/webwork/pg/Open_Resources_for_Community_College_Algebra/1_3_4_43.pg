DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
Context()->operators->redefine('>', using => ',' , from => 'Numeric');
Context()->lists->set(List => {separator => '>'});
Context()->flags->set(reduceConstantFunctions => 0);

@a = (1..99)[NchooseK(99, 1)];
@a = map{Real($_/10)} (@a);
do {
  @d = (2..9)[NchooseK(8,2)];
  push @a, map{Fraction(random_coprime([$_], [1..2*$_]))} (@d);
} until ($a[1] != $a[0] && $a[2] != $a[0]);
push @a, Formula("pi")/list_random(1,2,3,4,6);
$a[3] = $a[3]->reduce;
push @a, map{Formula("sqrt($_)")} (list_random(2,3,5,6,7,10));
@a = (@a)[NchooseK(5,5)];

$as = join('\quad', map{'{' . $_->TeX . '}'} (@a));
@b = PGsort(sub{$_[0] > $_[1]}, @a);
$bs = join('>', @b);

$comparison = Compute("$bs");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Use the [`\gt`] symbol to arrange the following numbers in order from greatest to least. For example, your answer might look like [`4 \gt 3 \gt 2 \gt 1 \gt 0\text{.}`]

END_PGML

######
# Body
######

BEGIN_PGML
[`[$as]`]

[_]{$comparison}{30}

END_PGML

