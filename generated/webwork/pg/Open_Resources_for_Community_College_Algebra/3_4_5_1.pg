DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("LimitedFraction")->flags->set(allowMixedNumbers => 0, showMixedNumbers => 0);
$m = Fraction(random(1, 9));
$b = non_zero_random(-9, 9);
@x = random_subset(2, 1 .. 9);
@y = map {$m*$_ + $b} (@x);
Context("Point");
@p = map {Point($x[$_], $y[$_])} (0,1);
Context()->flags->set(reduceConstants => 0);
$top = Formula("x - $y[0]");
$top = $top->substitute(x => $y[1]);
$bottom = Formula("x - $x[0]");
$bottom = $bottom->substitute(x => $x[1]);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the slope of the line passing through the two given points.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$p[0]]`] and [`[$p[1]]`]

[_]{$m}{10}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION

[```
\begin{aligned}
m \amp= \frac{y_2 - y_1}{x_2 - x_1}\\
\amp= \frac{[$top]}{[$bottom]}\\
\amp= \frac{[$top->reduce]}{[$bottom->reduce]}= [$m]
\end{aligned}
```]

END_PGML_SOLUTION

#############
# End Problem
#############

ENDDOCUMENT();
