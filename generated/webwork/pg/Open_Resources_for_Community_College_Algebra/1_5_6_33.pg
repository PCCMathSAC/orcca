DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "contextFiniteSolutionSets.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
Context("Fraction");
$var = list_random('a'..'n','p'..'z','A'..'N','P'..'T','V'..'Z');
Context()->variables->are($var => 'Real');
do {
  ($a, $b) = (-20..-2,2..20)[NchooseK(38,2)];
} until ($b % $a != 0);
$left = Formula("$a*$var")->reduce;
$right = Formula("$b")->reduce;
($left, $right) = ($left, $right)[NchooseK(2,2)];
$solution = Fraction($b, $a);
Context("FiniteSolutionSets");
Context()->variables->are($var => 'Real');
$solset = Formula("{$solution}");

############################################################
# Body
############################################################

BEGIN_PGML
Solve the equation.

[`[$left]=[$right]`]

[_]{$solset}{10}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
