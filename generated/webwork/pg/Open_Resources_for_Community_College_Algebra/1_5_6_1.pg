DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("LimitedFraction")->flags->set(allowMixedNumbers => 0, showMixedNumbers => 0);
do {
  ($a, $b) = random_coprime([2..10], [2..10]);
  $c = (random_coprime([2..10], [$b]))[0];
  $d = (random_coprime([2..10], [$c]))[0];
} until (gcd($a, $d) == 1);
$A = Fraction($a, $b);
$B = Fraction($c, $d);
$ans = $A*$B;

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Multiply the fractions.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$A]\cdot[$B]`]

[_]{$ans}{5}

END_PGML

#############
# End Problem
#############

