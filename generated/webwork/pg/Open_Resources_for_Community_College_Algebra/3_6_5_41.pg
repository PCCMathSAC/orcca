DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
Context()->noreduce('(-x)-y','(-x)+y');
($h,$k,$m) = random_subset(3, 2..5);
$k = -$k;
$f = Formula("$m(x - $h) + $k")->reduce;
$x1 = $h + 1;
$y1 = $k + $m;
$gt = GraphTool("{line, solid, ($h, $k), ($x1, $y1)}")->with(
  bBox => [-11, 11, 11, -11],
  availableTools => [ "LineTool" ],
  showInStatic => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Graph the linear equation by identifying the slope and one point on this line.

END_PGML

######
# Body
######

BEGIN_PGML
[`y=[$f]`]

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
