DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFiniteSolutionSets.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
$var = list_random('a'..'n','p'..'z','A'..'D', 'F'..'N','P'..'T','V'..'Z');
Context()->variables->are($var => 'Real');
($c, $d) = random_coprime([1..10], [2..10,12]);
$B = Fraction($c, $d);
$B = random(0,1) ? $B : -$B;
$left = Formula("-$var")->reduce;
$right = Formula("$B")->reduce;
$solution = -$B;
Context("FiniteSolutionSets");
Context()->variables->are($var => 'Real');
$solset = Formula("{$solution}");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[_]{$solset}{10}

END_PGML

