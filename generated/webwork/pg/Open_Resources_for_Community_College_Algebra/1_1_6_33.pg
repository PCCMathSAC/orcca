#######
# Setup
#######

($x, $y) = ('a'..'n', 'p'..'z')[NchooseK(25, 2)];
Context()->variables->are($x => 'Real', $y => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
($m, $n, $a, $b) = (-9..-1, 1..9)[NchooseK(18, 4)];
$expression = Formula("$x/$m + $y/$n")->reduce->reduce;
Context("LimitedFraction");
$r = Fraction($expression->eval($x => $a, $y => $b));

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`\displaystyle[$expression]`] for [`[$x]=[$a]\text{,}`] [`[$y]=[$b]`]

[_]{$r}{10}

END_PGML

