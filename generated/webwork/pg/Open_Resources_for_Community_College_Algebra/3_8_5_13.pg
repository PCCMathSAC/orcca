#######
# Setup
#######

$k = non_zero_random(-6,6);
Context("ImplicitPlane")->variables->are(x => 'Real', y => 'Real');
$line=ImplicitPlane("y=$k");

$image_1 = createLaTeXImage();
$image_1->addToPreamble(latexImagePreamble());
$image_1->BEGIN_LATEX_IMAGE
\begin{tikzpicture}
  \begin{axis}[
      width=0.33\orccaprintwidth
    ]
    \addplot+ {$k};
  \end{axis}
\end{tikzpicture}

END_LATEX_IMAGE

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Write an equation for the given line.

END_PGML

######
# Body
######

BEGIN_PGML
>> [@image(insertGraph($image_1), width=>600)@]*  <<

[_]{$line}{16}

END_PGML

