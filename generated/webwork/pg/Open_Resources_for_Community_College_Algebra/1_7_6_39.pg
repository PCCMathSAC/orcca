DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
do {
  $a = Fraction(random_coprime([2..9], [2..9]));
  $b = Fraction(random_coprime([2..9], [2..9]));
} until ($a != $b);
Context("Form");
$given = Formula("$a x - $b x");
$ab = $a - $b;
$ans = Formula("$ab x");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Simplify the given expression. Ideally, you are thinking about how the properties of algebra are helping you simplify.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$given]`]

[_]{$ans}{16}

END_PGML

#############
# End Problem
#############

