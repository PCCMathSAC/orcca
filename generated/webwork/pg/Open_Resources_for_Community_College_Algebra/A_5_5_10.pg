#######
# Setup
#######

($answer,$k,$c) = (2..5)[NchooseK(4,3)];
$b = $k*$c;
$a = $answer*$c*$b;
Context("LimitedNumeric");
$answer = Real($a/$b/$c);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Use the order of operations to simplify the expression.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$a] \div [$b]/[$c]`]

[_]{$answer}{5}

END_PGML

