DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
$set = list_random(
  [12, 'inches', 'foot', 'feet'],
  [36, 'inches', 'yard', 'yards'],
  [3, 'feet', 'yard', 'yards'],
  [5280, 'feet', 'mile', 'miles'],
  [1760, 'yards', 'mile', 'miles'],
);
($rate, $smalls, $big, $bigs) = @$set;
$expression = Formula("$rate x");

######
# Body
######

BEGIN_PGML
There are [`[$rate]`] [$smalls] in a [$big]. Write an expression representing how many [$smalls] are in [`x`] [$bigs].

[_]{$expression}{20}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
