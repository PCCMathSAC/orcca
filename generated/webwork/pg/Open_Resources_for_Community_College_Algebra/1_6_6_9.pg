($n, $d) = random_coprime([-10..-1],[2..10]);
Context("Fraction");
$a = Fraction($n,$d);
$ans = 1/$a;

############################################################
# Body
############################################################

BEGIN_PGML
Find the indicated inverse.

Find the multiplicative inverse of [`[$a]`]

[_]{$ans}{5}


END_PGML

