DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("LimitedFraction")->flags->set(requirePureFractions => 1, showMixedNumbers => 0);
($run, $rise) = random_coprime([2 .. 6], [1 .. 9]);
$m = Fraction($rise, $run);
$k = random(2,7);
$x[0] = non_zero_random(-9, 9);
$x[1] = $x[0] + $k*$run;
$y[0] = non_zero_random(-9, 9);
$y[1] = $y[0] + $k*$rise;
Context("Point");
@p = map {Point($x[$_], $y[$_])} (0,1);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the slope of the line passing through the two given points.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$p[0]]`] and [`[$p[1]]`]

[_]{$m}{10}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
