DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFraction.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
Context("LimitedFraction")->flags->set(allowMixedNumbers => 0, showMixedNumbers => 0);
$range = [2..11];
do {
  ($b,$c,$k) = random_pairwise_coprime($range, $range, $range);
  $a = random(1, $b - 1);
} until (gcd($k*$a - $c, $b) == 1);
$A = Fraction($a, $b);
$B = Fraction($c, $k*$b);
($A, $B) = num_sort($A, $B);
$ans = $B - $A;

############################################################
# Body
############################################################

BEGIN_PGML
Add or subtract the fractions.

[`[$B]-[$A]`]

[_]{$ans}{5}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
