DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$x = list_random('a'..'d', 'f'..'h', 'j'..'n', 'p'..'z');
Context()->variables->are($x => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
($m, $h, $k, $a) = (-9..-1, 1..9)[NchooseK(18, 4)];
Context()->flags->set(reduceConstants => 0);
$expression = Formula("$m($x - $h) + $k")->reduce;
$sol[0] = $expression->substitute($x => Formula("$a"));
$sol[1] = $a - $h;
$sol[2] = Formula("$m($sol[1]) + $k");
$sol[3] = $m*$sol[1];
$sol[4] = Formula("$sol[3] + $k");
Context("LimitedNumeric");
$r = Real($expression->eval($x => $a));

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$expression]`] for [`[$x]=[$a]`]

[_]{$r}{10}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
Substitute [`[$a]`] in for the variable [`[$x]`] and simplify:

[```
\begin{aligned}
\amp[$sol[0]]\\
\amp=[$sol[2]]\\
\amp=[$sol[4]]\\
\amp=[$r]
\end{aligned}
```]

END_PGML_SOLUTION

#############
# End Problem
