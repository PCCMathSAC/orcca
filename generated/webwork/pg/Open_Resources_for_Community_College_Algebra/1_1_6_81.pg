DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
$set = list_random(
  [60, 'seconds', 'minute', 'minutes'],
  [3600, 'seconds', 'hour', 'hours'],
  [60, 'minutes', 'hour', 'hours'],
  [1440, 'minutes', 'day', 'days'],
  [24, 'hours', 'day', 'days'],
);
($rate, $smalls, $big, $bigs) = @$set;
$expression = Formula("$rate x");

######
# Body
######

BEGIN_PGML
There are [`[$rate]`] [$smalls] in a [$big]. Write an expression representing how many [$smalls] are in [`x`] [$bigs].

[_]{$expression}{20}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
