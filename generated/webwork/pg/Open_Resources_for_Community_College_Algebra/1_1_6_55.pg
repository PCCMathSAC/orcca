#######
# Setup
#######

@m = (1..3)[NchooseK(3, 2)];
@m = num_sort(@m);
$a = $m[1]**2 - $m[0]**2;
$b = 2*$m[0]*$m[1];
$c = $m[1]**2 + $m[0]**2;
$x[0] = random(-10, 10, 1);
$x[1] = $x[0] + list_random(-1, 1)*$a;
$y[0] = random(-10, 10, 1);
$y[1] = $y[0] + list_random(-1, 1)*$b;
Context("LimitedNumeric");
$answer = Real($c);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`\sqrt{\left(x_2-x_1\right)^2 + \left(y_2-y_1\right)^2}`] for [`x_1=[$x[0]]\text{,}`] [`x_2=[$x[1]]\text{,}`] [`y_1=[$y[0]]\text{,}`] and [`y_2=[$y[1]]\text{.}`]

[_]{$answer}{15}

END_PGML

