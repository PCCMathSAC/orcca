DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFiniteSolutionSets.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
$x = list_random('a'..'n', 'p'..'z', 'A'..'N', 'P'..'T', 'V'..'Z');
Context()->variables->are($x => 'Real');
$sol = non_zero_random(-9, 9);
do {
  ($m, $n, $p) = random_subset(3, -9..-2, 2..9);
} until ($m + $n != $p);
($b, $d) = random_subset(2, -9..-1, 1..9);
$e = ($m + $n - $p)*$sol + $m*$b - $p*$d;
Context()->noreduce('(-x)-y', '(-x)+y');
$left = Formula("$m($x + $b) + $n $x")->reduce;
$right = Formula("$p($x + $d) + $e")->reduce;
Context("FiniteSolutionSets");
Context()->variables->are($x => 'Real');
$solset = Formula("{$sol}");

############################################################
# Body
############################################################

BEGIN_PGML
Solve the equation.

[`[$left]=[$right]`]

[_]{$solset}{16}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
