DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "contextInequalitySetBuilder.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
$var = list_random('a'..'n','p'..'z','A'..'D', 'F'..'N','P'..'T','V'..'Z');
Context()->variables->are($var => 'Real');
$c = list_random(-6 .. -2, 2 .. 6);
$a = Fraction(random_coprime([1..10], [2..10]));
$b = $a*$c;
$left = Formula("$a $var")->reduce;
$right = Formula("$b")->reduce;
$sign = list_random('\lt', '\gt', '\leq', '\geq');
%interval = (
  '\lt'  => "(-inf, $c)",
  '\gt'  => "($c, inf)",
  '\leq' => "(-inf, $c]",
  '\geq' => "[$c, inf)"
);
Context("Interval");
$interval = Interval($interval{$sign});
InequalitySetBuilder::UseVerticalSuchThat();
Context("InequalitySetBuilder-Only");
Context()->variables->are($var => 'Real');
%perlsign = (
  '\lt'  => "<",
  '\gt'  => ">",
  '\leq' => "<=",
  '\geq' => ">="
);
$perlsign = $perlsign{$sign};
$setbuilder = Compute("{ $var | $var $perlsign $c}");
$gt = GraphTool("{interval, $interval}")->with(
  availableTools => ['IntervalTool', 'IncludeExcludePointTool'],
  numberLine => 1,
  xAxisLabel => "$var",
  bBox => [ -8, 8 ],
  ticksDistanceX => 1,
  minorTicksX => 0,
  useBracketEnds => 1,
  showInStatic => 0,
  showCoordinateHints => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the inequality. Graph the solution set, and write the solution set using both interval notation and set-builder notation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left][$sign][$right]`]

[_]{$gt}{1}

[@KeyboardInstructions('In interval notation.')@]**

[_]{$interval}{12}

[@KeyboardInstructions('In set-builder notation. (If needed, type [|inf|]* or [|infinity|]* for [`\infty\text{,}`] [|>=|]* for [`\geq\text{,}`] and [|<=|]* for [`\leq\text{.}`])')@]**

[_]{$setbuilder}{12}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
