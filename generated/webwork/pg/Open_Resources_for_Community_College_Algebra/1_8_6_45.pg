DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextCurrency.pl",
  "parserLinearRelation.pl",
  "randomPerson.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$name = randomPerson();
$rate = random(4,8,0.01);
Context("Currency")->flags->set(trimTrailingZeros => 1);
$speed = Currency("$rate");
$initial = random(300,400,0.25);
$start = Currency("$initial");
$final = random(600,800,5);
$end = Currency("$final");
Context("LinearRelation")->variables->are(t => 'Real');
$equation = LinearRelation("$initial + $rate t = $final");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Write an equation to model the scenario. There is no need to solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
To save up for a new phone that costs [`[$end]\text{,}`] [$name] sets aside 1% of [$name->possessive] pay each week. This works out to [`[$speed]`] per week. At present, [$name->subject] [$name->have] [`[$start]`] saved up. How long will it be until [$name] has saved up enough? Write an equation to model this scenario. There is no need to solve it.

[@KeyboardInstructions('Use [|t|]* as the variable.')@]**

[_]{$equation}{20}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
