DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
Context()->noreduce('(-x)-y','(-x)+y');
do {
  ($n,$d) = random_coprime([1..9],[2..9]);
  $m = Fraction($n/$d);
  ($h,$k) = random_subset(2, 2..9);
  if (random(0,1)) {
    $h = -$h;
    $k = -$k;
  }
  $f = Formula("$m(x - $h) + $k")->reduce;
  $b = $f->eval(x => 0);
} until ($b != int(Real($b)));
$x1 = $h + $d;
$y1 = $k + $n;
$gt = GraphTool("{line, solid, ($h, $k), ($x1, $y1)}")->with(
  bBox => [-11, 11, 11, -11],
  availableTools => [ "LineTool" ],
  showInStatic => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Graph the linear equation by identifying the slope and one point on this line.

END_PGML

######
# Body
######

BEGIN_PGML
[`y=[$f]`]

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
