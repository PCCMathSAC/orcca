DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$var = list_random('a'..'n', 'p'..'z', 'A'..'D', 'F'..'N', 'P'..'T', 'V'..'Z');
Context("Fraction");
$b = Fraction(random_coprime([2..10],[2..10]));
Context("Form")->variables->are($var => 'Real');
$given = Formula("-($var + $b)");
Context()->lists->set(AbsoluteValue=>{open=>"(",close=>")"});
Context()->parens->set("("=>{removable=>0,type=>"AbsoluteValue",close=>")"});
$ans = Formula("-$var - $b");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Demonstrate that you know the meanings of the various algebraic properties by applying the given algebraic property to the given expression to get a new expression.

END_PGML

######
# Body
######

BEGIN_PGML
Apply the distributive property to [`[$given]\text{.}`]

[_]{$ans}{16}

END_PGML

