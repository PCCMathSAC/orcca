############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
$x = list_random('a'..'n', 'p'..'z');
Context()->variables->are($x => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
($m, $h, $k, $a) = (-9..-1, 1..9)[NchooseK(18, 4)];
$expression = Formula("($m $x + $h)/($k $x)")->reduce;
Context("LimitedFraction");
$r = Fraction($expression->eval($x => $a));

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

[`\displaystyle[$expression]`] for [`[$x]=[$a]`]

[_]{$r}{10}


END_PGML

############################################################
# End Problem
############################################################

