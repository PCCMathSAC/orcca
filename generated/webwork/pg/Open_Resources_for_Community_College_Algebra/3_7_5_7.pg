DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

($x, $y) = random_subset(2, 2..9);
$C = lcm($x,$y);
$A = $C/$x;
$B = $C/$y;
Context()->variables->add(y => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
$left = Formula("$A x + $B y");
$right = Formula("$C");
Context("Point");
$xi = Point($x,0);
$yi = Point(0,$y);
Context("Fraction");
$m = Fraction(-$y/$x);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find both intercepts and the slope of the line.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[@KeyboardInstructions('Enter the [`x`]-intercept here.')@]**

[_]{$xi}{5}

[@KeyboardInstructions('Enter the [`y`]-intercept here.')@]**

[_]{$yi}{5}

[@KeyboardInstructions('Enter the slope here.')@]**

[_]{$m}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
