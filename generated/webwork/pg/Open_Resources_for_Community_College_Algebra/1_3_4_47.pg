#######
# Setup
#######

$a = random(-7, 7);
InequalitySetBuilder::UseVerticalSuchThat();
Context("InequalitySetBuilder-Only");
$set_builder = Compute("{ x | x <= $a}");
Context("Interval");
$interval = Compute("(-inf, $a]");

$image_1 = createLaTeXImage();
$image_1->addToPreamble(latexImagePreamble());
$image_1->BEGIN_LATEX_IMAGE
\begin{tikzpicture}
  \begin{axis}
    [
      numberline,
      xlabel={\(x\)},
      width=0.47\orccaprintwidth,
    ]
    \addplot[infiniteclosedinterval] coordinates {(-12,0) ($a,0)};
  \end{axis}
\end{tikzpicture}

END_LATEX_IMAGE

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Express the given interval in set-builder notation and interval notation.

END_PGML

######
# Body
######

BEGIN_PGML
>> [@image(insertGraph($image_1), width=>600, alt=>qq"a numberline with a shaded region; the shaded region extends all the way to the left with an arrowhead; it extends to the right up to $a where there is a right bracket")@]*  <<

[@KeyboardInstructions('In set-builder notation:')@]**

[_]{$set_builder}{12}

[@KeyboardInstructions('In interval notation:')@]**

[_]{$interval}{12}

END_PGML

