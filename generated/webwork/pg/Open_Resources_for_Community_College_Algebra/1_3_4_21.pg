DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "contextFraction.pl",
  "parserPopUp.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
@d = (2..9)[NchooseK(8,2)];
($a, $b) = map{Fraction(random_coprime([1..2*$_], [$_]))} (@d);
$comp = list_random('<', '>');
$ans = ($a > $b && $comp eq '>' || $a < $b && $comp eq '<') ? 'True' : 'False';
$comp = list_random('<', '\leq') if ($comp eq '<');
$comp = list_random('>', '\geq') if ($comp eq '>');
$tf = DropDownTF($ans, showInStatic => 0);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Decide if each comparison is true or false.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$a] [$comp] [$b]`]

[_]{$tf}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
