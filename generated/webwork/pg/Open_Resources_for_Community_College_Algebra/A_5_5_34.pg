DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$grouping = list_random(['(',')'],['[',']']);
$c = random(2,4,1);
$aminusb = random(2,100**(1/$c),1);
$b = random(1,4,1);
$a = $aminusb + $b;
Context("LimitedNumeric");
$answer = Real(($a-$b)**$c);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Use the order of operations to simplify the expression that has grouping symbols.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$grouping->[0]] [$a] - [$b] [$grouping->[1]] ^{[$c]} `]

[_]{$answer}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
