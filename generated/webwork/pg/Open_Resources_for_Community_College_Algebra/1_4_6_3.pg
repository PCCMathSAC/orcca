Context("LimitedFraction")->flags->set(allowMixedNumbers => 0, showMixedNumbers => 0);
$root = Fraction(random_coprime([1..10], [2..10]));
$square = $root**2;

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the square root.

END_PGML

######
# Body
######

BEGIN_PGML
[`\sqrt{[$square]}`]

[_]{$root}{3}

END_PGML

