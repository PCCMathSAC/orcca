#######
# Setup
#######

$var = list_random('a'..'n','p'..'z','A'..'D', 'F'..'N','P'..'T','V'..'Z');
Context()->variables->are($var => 'Real');
($a, $b) = (1..20)[NchooseK(20,2)];
($a, $b) = map{$_ + random(0.1, 0.9, 0.1)} ($a, $b);
$b = random(0,1) ? $b : -$b;
$left = Formula("$var + $a")->reduce;
$right = Formula("$b")->reduce;
Context("FiniteSolutionSets");
Context()->flags->remove("NumberCheck");
Context()->variables->are($var => 'Real');
$solution = $b - $a;
$solset = Formula("{$solution}");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[_]{$solset}{10}

END_PGML

