DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserCheckboxList.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$h = non_zero_random(-9,9);
@y = random_subset(4,-4..4);
@x = ($h,$h,$h,$h);
$x[2] += non_zero_random(-5,5);
($x[3],$y[3]) = ($y[3],$x[3]);
Context("Point");
@p = map {Point($x[$_],$y[$_])} (random_subset(4,0..3));
@ans;
for (0..3) {
  push(@ans, $_) if (($p[$_]->value)[0] == $h);
}
$checks = CheckboxList([map {'\(' . $_->TeX . '\)'} (@p)], [@ans], options);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Which of the ordered pairs are solutions to the given equation? There may be more than one correct answer.

END_PGML

######
# Body
######

BEGIN_PGML
[`x=[$h]`]

[_]{$checks}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
