#######
# Setup
#######

$h = non_zero_random(-9,9);
Context("ImplicitPlane")->variables->are(x => 'Real', y => 'Real');
$line=ImplicitPlane("x=$h");
@y = random_subset(2, -9..9);
@p = map {Point($h,$_)} (@y);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Write an equation for the given line.

END_PGML

######
# Body
######

BEGIN_PGML
The line that passes through [`[$p[0]]`] and [`[$p[1]]\text{.}`]

[_]{$line}{16}

END_PGML

