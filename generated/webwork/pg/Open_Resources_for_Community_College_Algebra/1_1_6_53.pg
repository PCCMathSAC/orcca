Context("LimitedFraction");
@x = (-10..10)[NchooseK(21, 2)];
@y = (-10..10)[NchooseK(21, 2)];
$answer = Fraction(($y[1] - $y[0])/($x[1] - $x[0]));

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`\dfrac{y_2-y_1}{x_2-x_1}`] for [`x_1=[$x[0]]\text{,}`] [`x_2=[$x[1]]\text{,}`] [`y_1=[$y[0]]\text{,}`] and [`y_2=[$y[1]]\text{.}`]

[_]{$answer}{15}

END_PGML

