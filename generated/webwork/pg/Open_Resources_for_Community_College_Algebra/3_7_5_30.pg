DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserImplicitPlane.pl",
  "contextCurrency.pl",
  "contextForm.pl",
  "randomPerson.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
Context("ImplicitPlane");
Context()->flags->set(reduceConstants=>0);
Context()->flags->set(reduceConstantFormulas=>0);
Context()->flags->set(showExtraParens=>0);
Context()->variables->are(x=>'Real', y=>'Real');
Context()->noreduce('(-x)-y','(-x)+y','(-x)*y','x*(-y)','-n');
$A = random(4,5,0.01);
$B = random(9,11,0.01);
$C = $A*random(12,20) + $B*random(12,20);
$C = int($C/100 + 0.5)*100;
$ansSTstring = "$A*x+$B*y=$C";
$left1 = Compute("$A*x+$B*y")->reduce;
$ansSTstringTeX = $left1->TeX."=$C";
$ansST = ImplicitPlane($ansSTstring);
$evaluator=$ansST->cmp(correct_ans_latex_string => $ansSTstringTeX)->withPostFilter(sub{
  my $ansHash = shift;
  my $student = $ansHash->{original_student_ans};
  my @sides = split('=',"$student");
  #if it's an implicit plane object, reset how student's answer is displayed:
  if (defined $ansHash->{student_formula}) {
    if ($ansHash->{student_formula}->cmp_class eq "an Implicit line") {
      $ansHash->{preview_text_string} = "$sides[0]=$sides[1]";
      my $leftTex = Formula("$sides[0]")->TeX;
      my $rightTex = Formula("$sides[1]")->TeX;
      $ansHash->{preview_latex_string} = "$leftTex=$rightTex";
      $ansHash->{student_ans} = $ansHash->{original_student_ans};
    }
  };
  # if they have it correct, then check each side to see
  # whether x and y are on the same side of =
  if ($ansHash->{score}) {
    if ((($sides[0] =~ /x/) && ($sides[1] =~ /y/)) || (($sides[1] =~ /x/) && ($sides[0] =~ /y/))) {
      $ansHash->{score} = 0;
      $ansHash->{ans_message} = "This is an equation for the line, but it is not in standard form.";
     }
  }
  return $ansHash;
});
$p = randomPerson();
Context("Currency")->flags->set(trimTrailingZeros => 1);
$Ad = Currency($A);
$Bd = Currency($B);
$Cd = Currency($C);

############################################################
# Body
############################################################

BEGIN_PGML
[$p] is buying peanuts and cashews in bulk to make a barrel of mixed nuts. Each pound of peanuts costs [$Ad], and each pound of cashews costs [$Bd]. [$p->they] can spend a total of [$Cd]. Assume [$p] will spend the full amount. Write a linear equation in standard form that models the amounts of peanuts and cashews [$p->they] can purchase.

[_]{$evaluator}{16}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
