DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextCurrency.pl",
  "randomPerson.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

@p = randomPerson(n => 2);
@w = (random(50,70), random(80,90));
do {
  $price = random(0.7,1.2,0.01);
} until ($price != 1);
Context("Currency");
@c = map {Currency($_*$price)} (@w);

######
# Body
######

BEGIN_PGML
[$p[0]] and [$p[1]] went to the weekend market to buy apples in bulk for a school event, canning lots of applesauce. [$p[0]] bought [$w[0]] lb of apples and paid [$c[0]]. [$p[1]] has bagged [$p[1]->their] apples and has [$w[1]] lb of apples ready. How much will it [$p[1]]'s bag of apples cost?

[_]{$c[1]}{16}

END_PGML

