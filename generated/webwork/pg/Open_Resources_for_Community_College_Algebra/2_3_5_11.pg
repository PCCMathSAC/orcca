DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextFiniteSolutionSets.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
$den = random(2,12);
@num = random_pairwise_coprime([1..12],[1..12],[$den]);
$m = Fraction($num[0]/$den);
$c = Fraction($num[1]/$den);
$b = non_zero_random(-12,12);
$left = Formula("$m x + $b")->reduce;
$right = Formula("$c");
$sol = ($c - $b)/$m;
Context("FiniteSolutionSets");
$solution = Formula("{$sol}");
$lcd = $den;

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the given equation. Practice clearing the denominator(s) as a first step.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left] = [$right]`]

[@KeyboardInstructions('What LCD will you use?')@]**

[_]{$lcd}{4}

[@KeyboardInstructions('Solve the equation.')@]**

[_]{$solution}{16}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
