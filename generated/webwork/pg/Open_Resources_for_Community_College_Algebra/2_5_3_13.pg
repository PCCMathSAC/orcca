DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

@x = random_subset(4, ('a'..'n','p'..'z','A'..'D', 'F'..'N','P'..'T','V'..'Z'));
Context()->variables->are(map {$_ => 'Real'} (@x));
$left = Formula("$x[1] $x[0] + $x[2]")->reduce;
$right = Formula("$x[3]")->reduce;
parser::Assignment->Allow;
$ans = Assignment("$x[0] = ($x[3] - $x[2])/$x[1]");
$leftsol[0] = Formula("$x[1] $x[0] + $x[2] - $x[2]")->reduce;
$rightsol[0] = Formula("$x[3] - $x[2]")->reduce;
$leftsol[1] = Formula("$x[1] $x[0]")->reduce;
$rightsol[1] = Formula("$x[3] - $x[2]")->reduce;
$leftsol[2] = Formula("$x[0]")->reduce;
$rightsol[2] = Formula("($x[3] - $x[2])/$x[1]")->reduce;

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Isolate the indicated variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$x[0]]`] in [`[$left]=[$right]`]

[_]{$ans}{16}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
We need to keep our focus on [`[$x[0]]`] and take algebra steps that bring us closer to isolating [`[$x[0]]\text{.}`]

[```
\begin{aligned}
[$left] \amp= [$right]\\
[$leftsol[0]] \amp= [$rightsol[0]]\\
[$leftsol[1]] \amp= [$rightsol[1]]\\
[$leftsol[2]] \amp= [$rightsol[2]]
\end{aligned}
```]

END_PGML_SOLUTION

