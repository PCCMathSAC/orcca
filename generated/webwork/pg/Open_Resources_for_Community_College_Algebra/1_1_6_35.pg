DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
Context("Fraction");
$var = RandomVariableName();
Context()->variables->are($var => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
($x, $h) = map{$_-9} (NchooseK(19, 2));
$k = random(-9, 9, 1);
$denom = $x - $h;
$expression = Formula("1/$denom($var - $h)^2 + $k")->reduce;
$answer = $expression->eval($var => $x);
$answer = Real($answer);
Context("LimitedNumeric");
$answer = Real($answer);

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

[`[$expression]`] for [`[$var]=[$x]\text{.}`]

[_]{$answer}{15}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
