[`
              \begin{aligned}[t]
              \frac{12}{5}\div5\amp=\frac{12}{5}\cdot\frac{1}{5}\\
              \amp=\frac{12}{25}\\
              \ 
              \end{aligned}
              `]

END_PGML_SOLUTION

