loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserNumberWithUnits.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
Context('Numeric');
$Y = random(1900, 2020, 1);
$age = $Y - 1776;
$newUnits = [
  {name => 'years', conversion => {factor => 1, yr => 1}},
  {name => 'yrs',   conversion => {factor => 1, yr => 1}},
  {name => 'year',  conversion => {factor => 1, yr => 1}},
];
$A = NumberWithUnits("$age years",{newUnit => $newUnits});

############################################################
# Body
############################################################

BEGIN_PGML
To find the age of the United States in year [`Y\text{,}`] there is a formula [`A = Y - 1776\text{.}`]

How old was the United States in the year [$Y]?

[_]{$A}{10}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
