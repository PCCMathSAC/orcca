DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$b = non_zero_random(20,100);
($n, $d) = random_coprime([10..20],[10..20]);
Context("Fraction")->variables->add(y => 'Real');
$m = Fraction($n/$d);
Context()->noreduce('(-x)+y','(-x)-y');
parser::Assignment->Allow;
$equation = Formula("y = $m x + $b")->reduce;
@x = num_sort(random_subset(2,-9..-1, 1..9));
@x = map {$_*$d} @x;
@y = map {$m*$_ + $b} (@x);
@p = map {Point($x[$_],$y[$_])} (0,1);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
A line passes through the two given points. Find the line's equation in slope-intercept form.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$p[0]]`] and [`[$p[1]]`]

[_]{$equation}{16}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
