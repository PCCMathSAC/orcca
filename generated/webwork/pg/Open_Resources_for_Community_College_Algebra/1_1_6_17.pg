#######
# Setup
#######

$x = list_random('a'..'d', 'f'..'h', 'j'..'n', 'p'..'z');
Context()->variables->are($x => 'Real');
($a, $b) = (2..9)[NchooseK(8, 2)];
$b = -$b;
$expression = Formula("$x^2");
Context("LimitedNumeric");
$ra = Real($expression->eval($x => $a));
$rb = Real($expression->eval($x => $b));

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

##########
# Scaffold
##########

Scaffold::Begin(numbered => 1,is_open => "correct_or_first_incorrect",can_open => always,);

#########
# Section
#########

Section::Begin("");

BEGIN_PGML
[`[$expression]`] for [`[$x]=[$a]`]

[_]{$ra}{10}

END_PGML

Section::End();

#########
# Section
#########

Section::Begin("");

BEGIN_PGML
[`[$expression]`] for [`[$x]=[$b]`]

[_]{$rb}{10}

END_PGML

Section::End();

Scaffold::End();

