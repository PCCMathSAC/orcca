@x = qw(c r);
Context("Fraction")->variables->are(map {$_ => 'Real'} (@x));
parser::Assignment->Allow;
$ans = Assignment("r = c/(2 pi)");
$introduction_image_1 = createLaTeXImage();
$introduction_image_1->addToPreamble(latexImagePreamble());
$introduction_image_1->BEGIN_LATEX_IMAGE
\begin{tikzpicture}[x=1.8cm,y=1.8cm]
\draw[thick, fill=secondcolor!20!white, postaction={decorate,decoration={text along path,text align=center, transform={yshift=1ex},text={circumference $c$}}}] (1,0) arc (270:-90:1);
\draw[thick] (1,1) -- node[pos=0.5, above] {radius \(r\)} (2,1);
\draw[thick, fill=secondcolor!20!white, postaction={decorate,decoration={text along path,text align=center, transform={yshift=1ex},text={circumference $c$}}}] (4,0) arc (270:-90:1);
\draw[thick] (3,1) -- node[pos=0.5, above] {diameter \(d\)} (5,1);
\end{tikzpicture}

END_LATEX_IMAGE

############################################################
# Body
############################################################

BEGIN_PGML
The circumference of a circle can be found with the equation [`c=2\pi r\text{,}`] where [`r`] is the radius, or with the equation [`c=\pi d\text{,}`] where [`d`] is the diameter.

>> [@image(insertGraph($introduction_image_1), width=>300)@]*  <<

Solve the equation [`c=2\pi r`] for [`r\text{.}`]

[@KeyboardInstructions('You may type [`\pi`] as [|pi|]* or [|π|]*.')@]**

[_]{$ans}{16}


END_PGML

