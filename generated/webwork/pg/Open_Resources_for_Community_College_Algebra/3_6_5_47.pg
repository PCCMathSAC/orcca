DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Numeric");
Context()->noreduce('(-x)-y','(-x)+y');
do {
  $m = non_zero_random(-0.9,0.9,0.1);
  ($h,$k) = random_subset(2, 2..9);
  if ($m > 0) {
    if (random(0,1)) {
      $h = -$h;
      $k = -$k;
    }
  } else {
    if (random(0,1)) {
      $h = -$h;
    } else {
      $k = -$k;
    }
  }
  $f = Formula("$m(x - $h) + $k")->reduce;
  $b = $f->eval(x => 0);
} until ($b != int(Real($b)));
$x1 = $h + 10;
$y1 = Real($k + $m*10);
$gt = GraphTool("{line, solid, ($h, $k), ($x1, $y1)}")->with(
  bBox => [-11, 11, 11, -11],
  availableTools => [ "LineTool" ],
  showInStatic => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Graph the linear equation by identifying the slope and one point on this line.

END_PGML

######
# Body
######

BEGIN_PGML
[`y=[$f]`]

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
