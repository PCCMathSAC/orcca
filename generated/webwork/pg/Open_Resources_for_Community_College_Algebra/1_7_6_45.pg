DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Form");
$var = list_random('a'..'n', 'p'..'z', 'A'..'D', 'F'..'N', 'P'..'T', 'V'..'Z');
Context()->variables->are($var => 'Real');
($a, $b, $c, $d) = (2..9)[NchooseK(8,4)];
$given = Formula("$a ($b $var + $c) - $d");
$ab = $a*$b;
$acd = $a*$c - $d;
$ans = Formula("$ab $var + $acd");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Simplify the given expression. Ideally, you are thinking about how the properties of algebra are helping you simplify.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$given]`]

[_]{$ans}{16}

END_PGML

#############
# End Problem
#############

