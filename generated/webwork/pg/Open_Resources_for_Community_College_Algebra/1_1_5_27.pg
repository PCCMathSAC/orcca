DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "niceTables.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

@x = num_sort(random_subset(5, 1 .. 99));
@y = num_sort(random_subset(5, 1 .. 999));
($a,$b) = num_sort(random_subset(2, 0 .. 4));
Context("LimitedFraction")->flags->set(allowMixedNumbers => 0, showMixedNumbers => 0);
$m = Fraction($y[$b] - $y[$a], $x[$b] - $x[$a]);

######
# Body
######

BEGIN_PGML
Find the rate of change between the two given points.

>> [@DataTable(
  [
    [
     [PGML('[`x`]'),
      rowbottom => '2',
      midrule => '1',],
     PGML('[`y`]'),
    ],
    [
     PGML('[`[$x[0]]`]'),
     PGML('[`[$y[0]]`]'),
    ],
    [
     PGML('[`[$x[1]]`]'),
     PGML('[`[$y[1]]`]'),
    ],
    [
     PGML('[`[$x[2]]`]'),
     PGML('[`[$y[2]]`]'),
    ],
    [
     PGML('[`[$x[3]]`]'),
     PGML('[`[$y[3]]`]'),
    ],
    [
     PGML('[`[$x[4]]`]'),
     PGML('[`[$y[4]]`]'),
    ],
  ],
      align => 'r!{\vrule width 0.07em}r',
      valign => 'middle',);@]* <<

From [`x=[$x[$a]]`] to [`x=[$x[$b]]\text{.}`]

[_]{$m}{5}

END_PGML

#############
# End Problem
