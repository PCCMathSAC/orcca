DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("LimitedFraction")->flags->set(requirePureFractions => 1, showMixedNumbers => 0);
do {
  $x[0] = Fraction(random_coprime([-9 .. -1, 1 .. 9], [2 .. 9]));
  $x[1] = Fraction(random_coprime([-9 .. -1, 1 .. 9], [2 .. 9]));
} until ($x[0] != $x[1]);
$y[0] = Fraction(random_coprime([-9 .. -1, 1 .. 9], [2 .. 9]));
$y[1] = Fraction(random_coprime([-9 .. -1, 1 .. 9], [2 .. 9]));
$m = ($y[1] - $y[0])/($x[1] - $x[0]);
@p = map {Point($x[$_], $y[$_])} (0,1);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the slope of the line passing through the two given points.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$p[0]]`] and [`[$p[1]]`]

[_]{$m}{10}

END_PGML

#############
# End Problem
#############

