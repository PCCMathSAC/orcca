TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
Context("Fraction-NoDecimals");
$n=random(100,800,10)+random(1,9,1);
$t=random(1,9,1)+random(1,9,1)/10;
$f=Fraction($t+$n/999);

############################################################
# Body
############################################################

BEGIN_PGML
Write the rational number [`[$t]\overline{[$n]}=[$t][$n][$n]\ldots`] as a fraction.

[_]{$f}{10}


END_PGML

############################################################
# End Problem
