DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserFormulaWithUnits.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction");
$rate = Fraction(random(1,11),12);
$speed = FormulaWithUnits("$rate ft");
$initial = random(4,6);
$final = random(10,12);
$solution = ($final - $initial)/$rate;
$time = FormulaWithUnits("$solution yr");

######
# Body
######

BEGIN_PGML
You planted a young tree in front of your house, and it was [`[$initial]`] feet tall. Ever since, it has been growing by [`[$speed]`] each year. How many years will it take for the tree to grow to be [$final] feet tall?

[_]{$time}{20}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
