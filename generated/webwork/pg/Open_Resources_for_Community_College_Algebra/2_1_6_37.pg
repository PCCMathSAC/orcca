DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFiniteSolutionSets.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$x = list_random('a'..'n', 'p'..'z', 'A'..'D', 'F'..'N', 'P'..'T', 'V'..'Z');
Context()->variables->are($x => 'Real');
$sol = non_zero_random(-9, 9);
do {
  ($m, $n, $p) = random_subset(3, -9..-2, 2..9);
} until ($m + $n != $p);
($b, $d) = random_subset(2, -9..-1, 1..9);
$e = ($m + $n - $p)*$sol + $m*$b - $p*$d;
Context()->noreduce('(-x)-y', '(-x)+y');
$left = Formula("$m($x + $b) + $n $x")->reduce;
$right = Formula("$p($x + $d) + $e")->reduce;
Context("FiniteSolutionSets");
Context()->variables->are($x => 'Real');
$solset = Formula("{$sol}");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[_]{$solset}{16}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
