DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "niceTables.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

@x = (random_subset(3, -4..-1), random_subset(2, 1..5));
$f = Formula("abs(x)");
@y = map{$f->eval(x => $_)} (@x);
Context("Numeric")->variables->add(y => 'Real');
parser::Assignment->Allow;
$eq = Formula("y = $f");

######
# Body
######

BEGIN_PGML
Write an equation in the form [`y=\ldots`] suggested by the pattern in the table.

>> [@DataTable(
  [
    [
     [PGML('[`x`]'),
      rowbottom => '2',
      midrule => '1',],
     PGML('[`y`]'),
    ],
    [
     PGML('[`[$x[0]]`]'),
     PGML('[`[$y[0]]`]'),
    ],
    [
     PGML('[`[$x[1]]`]'),
     PGML('[`[$y[1]]`]'),
    ],
    [
     PGML('[`[$x[2]]`]'),
     PGML('[`[$y[2]]`]'),
    ],
    [
     PGML('[`[$x[3]]`]'),
     PGML('[`[$y[3]]`]'),
    ],
    [
     PGML('[`[$x[4]]`]'),
     PGML('[`[$y[4]]`]'),
    ],
  ],
      align => 'rl',
      valign => 'middle',);@]* <<

[_]{$eq}{20}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
Each [`y`]-value is the square root of the corresponding [`x`]-value. So the equation is [`[$eq]\text{.}`]

END_PGML_SOLUTION

