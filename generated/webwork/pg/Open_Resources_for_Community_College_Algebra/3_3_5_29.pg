DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "niceTables.pl",
  "contextForm.pl",
  "parserPopUp.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
$m = random(2, 9);
$b = random(10, 100);
$f = Formula("$m x + $b");
@x = (0..5);
@y = map{$f->eval(x => $_)} (@x);
$yes = DropDown(['yes','no'], 0, showInStatic => 0);
$no = DropDown(['yes','no'], 1, showInStatic => 0);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Does the table show that [`x`] and [`y`] have a linear relationship?

END_PGML

######
# Body
######

BEGIN_PGML
>> [@DataTable(
  [
    [
     [PGML('[`x`]'),
      rowbottom => '2',
      midrule => '1',],
     PGML('[`y`]'),
    ],
    [
     PGML('[`[$x[0]]`]'),
     PGML('[`[$y[0]]`]'),
    ],
    [
     PGML('[`[$x[1]]`]'),
     PGML('[`[$y[1]]`]'),
    ],
    [
     PGML('[`[$x[2]]`]'),
     PGML('[`[$y[2]]`]'),
    ],
    [
     PGML('[`[$x[3]]`]'),
     PGML('[`[$y[3]]`]'),
    ],
    [
     PGML('[`[$x[4]]`]'),
     PGML('[`[$y[4]]`]'),
    ],
    [
     PGML('[`[$x[5]]`]'),
     PGML('[`[$y[5]]`]'),
    ],
  ],
      align => '*{2}{r}',
      valign => 'middle',);@]* <<

[_]{$yes}{5}

END_PGML

##########
# Solution
##########

BEGIN_PGML_SOLUTION
As each [`x`]-value increases by [`1\text{,}`] the [`y`]-value increases by [`[$m]\text{.}`] So this table does show that [`x`] and [`y`] have a linear relationship.

END_PGML_SOLUTION

#############
# End Problem
#############

ENDDOCUMENT();
