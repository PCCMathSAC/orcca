DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

@x = map {$_/10} (num_sort(random_subset(3, -90..90)));
@y = map {$_/10} (num_sort(random_subset(3, -90..90)));
$m[0] = ($y[1] - $y[0])/($x[1] - $x[0]);
$m[1] = ($y[2] - $y[0])/($x[2] - $x[0]);
$m[2] = ($y[2] - $y[1])/($x[2] - $x[1]);
$m = max(@m);
Context("Point");
@p = map {Point($x[$_], $y[$_])} (0..2);
@p = random_subset(3, @p);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Determine the steepest slope for a line connecting two points from the list.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$p[0]]\text{,}`] [`[$p[1]]\text{,}`] [`[$p[2]]`]

[_]{$m}{10}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
