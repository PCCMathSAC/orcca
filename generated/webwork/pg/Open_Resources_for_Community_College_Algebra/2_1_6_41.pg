DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextFiniteSolutionSets.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$x = list_random('a'..'n', 'p'..'z', 'A'..'D', 'F'..'N', 'P'..'T', 'V'..'Z');
Context("Fraction")->variables->are($x => 'Real');
do {
  do {
    ($m, $n, $p) = random_subset(3, -9..-1, 1..9);
  } until ($m + $n != $p);
  ($b, $c, $d) = random_subset(3, -9..-1, 1..9);
  $sol = Fraction($c + $d - $b, $m + $n - $p);
} until (($sol->value)[1] != 1);
Context()->noreduce('(-x)-y', '(-x)+y');
$left = Formula("$m $x + $b + $n $x")->reduce;
$right = Formula("$c + $p $x + $d")->reduce;
Context("FiniteSolutionSets");
Context()->variables->are($x => 'Real');
$solset = Formula("{$sol}");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$left]=[$right]`]

[_]{$solset}{16}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
