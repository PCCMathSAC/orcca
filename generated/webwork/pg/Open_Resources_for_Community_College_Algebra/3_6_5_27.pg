DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

($h,$k) = random_subset(2,2..9);
($n,$d) = random_coprime([1..9],[2..9]);
Context("Fraction");
$m = Fraction($n/$d);
Context()->noreduce('(-x)-y','(-x)+y');
$f = Formula("$m(x-$h)+$k")->reduce;
$b = $f->eval(x => 0);
Context("Form")->variables->add(y=>'Real');
Context()->noreduce('(-x)+y','(-x)-y');
parser::Assignment->Allow;
Context()->flags->set(reduceConstants => 0);
$absb = abs($b);
$sign = ($b > 0) ? '+' : '-';
$si = Formula("y = $m x $sign $absb");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Change the given point-slope equation to slope-intercept form.

END_PGML

######
# Body
######

BEGIN_PGML
[`y=[$f]`]

[_]{$si}{16}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
