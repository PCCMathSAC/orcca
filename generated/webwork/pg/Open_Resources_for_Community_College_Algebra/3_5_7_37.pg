DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context("Fraction")->variables->add(y => 'Real');
$m = Fraction(random_coprime([2..9],[2..9]));
Context()->noreduce('(-x)+y','(-x)-y');
parser::Assignment->Allow;
$equation = Formula("y = $m x")->reduce;
($n,$d) = $m->value;
$gt = GraphTool("{line, solid, (0, 0), ($d, $n)}")->with(
  bBox => [-11, 11, 11, -11],
  availableTools => [ "LineTool" ],
  showInStatic => 0,
);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Graph the equation.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$equation]`]

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

