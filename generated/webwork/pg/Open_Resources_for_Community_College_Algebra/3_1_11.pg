DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserGraphTool.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
%options = ('positive' => 1, 'negative' => -1);
$posneg = list_random(lex_sort(keys %options));
$y = $options{$posneg}; 
$gt = GraphTool("{fill,(1,$y)}", "{fill,(-1,$y)}")->with(
  availableTools => ['FillTool'],
  staticObjects => ["{line,solid,(0,0),(0,1)}","{line,solid,(0,0),(1,0)}"],
  showInStatic => 0,
  showCoordinateHints => 0,
);

######
# Body
######

BEGIN_PGML
Sketch a Cartesian coordinate plane and then shade the quadrants where the second coordinate is [$posneg].

[_]{$gt}{1}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
