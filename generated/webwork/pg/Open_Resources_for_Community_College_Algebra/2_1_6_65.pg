DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextCurrency.pl",
  "randomPerson.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$name = randomPerson();
$initial = random(80,120,5);
Context("Currency")->flags->set(trimTrailingZeros => 1);
$start = Currency($initial);
$rate = random(12,18);
$speed = Currency($rate);
$final = $initial + $rate*random(12,23);
$end = Currency($final);
$solution = ($final - $initial)/$rate;
$n = Real($solution);

######
# Body
######

BEGIN_PGML
For [$name]'s 8th birthday party, [$name->possessive] parents rented a venue that charges a flat fee of [`[$start]`] plus [`[$speed]`] per guest. Ultimately it cost [$name]'s parents [`[$end]\text{.}`] How many guests were there?

[_]{$n}{20}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
