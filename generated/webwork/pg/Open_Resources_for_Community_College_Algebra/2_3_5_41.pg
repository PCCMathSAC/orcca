DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "randomPerson.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
$p = randomPerson();
do {
  $homework = random(80,100);
  $midterm = random(70,90);
  $goal = list_random(70,80,90);
  $sol = 3*($goal - ($homework/2 + $midterm/6));
} until ($goal > 0 && $goal < 100);

######
# Body
######

BEGIN_PGML
In one college math course, the final grade (out of [`100`] points) is calculated by adding one-half of the homework average, one-sixth of the midterm score, and one-third of the final exam score.

[$p] has [$homework] for [$p->their] homework average and [$midterm] for [$p->their] midterm score. [$p->Their] goal is to finish the course with a final grade of [$goal]. What must [$p->they] score on the final exam?

[_]{$sol}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
