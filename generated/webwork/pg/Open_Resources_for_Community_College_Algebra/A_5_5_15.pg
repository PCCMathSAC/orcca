#######
# Setup
#######

$c = list_random(2..4);
$b = random(2,30**(1/$c),1);
$answer = list_random(2..9);
$a = $answer*$b**$c;
Context("LimitedNumeric");
$answer = Real($a/$b**$c);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Use the order of operations to simplify the expression.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$a] / [$b]^{[$c]}`]

[_]{$answer}{5}

END_PGML

