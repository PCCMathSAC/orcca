  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');
COMMENT('This problem is scaffolded with multiple parts');

#######
# Setup
#######

@x = random_subset(3, ('a'..'n','p'..'z','A'..'D', 'F'..'N','P'..'T','V'..'Z'));
@a = random_subset(2, 2..9);
Context("Fraction")->variables->are($x[0] => 'Real');
$left[0] = Formula("$x[0]/$a[0]")->reduce;
$right[0] = Formula("$a[1]")->reduce;
Context("Fraction")->variables->are(map {$_ => 'Real'} (@x));
$left[1] = Formula("$x[0]/$x[1]")->reduce;
$right[1] = Formula("$x[2]")->reduce;
Context("FiniteSolutionSets")->variables->are($x[0] => 'Real');
$sol = $a[1]*$a[0];
$ans[0] = Formula("{$sol}");
Context("Numeric")->variables->are(map {$_ => 'Real'} (@x));
parser::Assignment->Allow;
$ans[1] = Assignment("$x[0] = $x[2]*$x[1]");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Solve the equation for the indicated variable.

END_PGML

######
# Body
######

##########
# Scaffold
##########

Scaffold::Begin(numbered => 1,is_open => "correct_or_first_incorrect",can_open => always,);

#########
# Section
#########

Section::Begin("");

BEGIN_PGML
[`[$left[0]]=[$right[0]]`] for [`[$x[0]]\text{.}`]

[_]{$ans[0]}{16}

END_PGML

Section::End();

#########
# Section
#########

Section::Begin("");

BEGIN_PGML
[`[$left[1]]=[$right[1]]`] for [`[$x[0]]\text{.}`]

[_]{$ans[1]}{16}

END_PGML

