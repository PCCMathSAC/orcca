DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "scaffold.pl",
  "parserAssignment.pl",
  "contextFiniteSolutionSets.pl",
  "contextForm.pl",
