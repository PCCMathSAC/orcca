DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserAssignment.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());


############################################################
# PG Setup Code
############################################################
$b = non_zero_random(-9,9);
($n, $d) = random_coprime([2..9],[2..9]);
$n = -$n;
Context("Fraction")->variables->add(y => 'Real');
$m = Fraction($n/$d);
Context()->noreduce('(-x)+y','(-x)-y');
parser::Assignment->Allow;
$equation = Formula("y = $m x + $b")->reduce;
@x = num_sort(random_subset(2,-9..-1));
@x = map {$_*$d} @x;
@y = map {$m*$_ + $b} (@x);
@p = map {Point($x[$_],$y[$_])} (0,1);

############################################################
# Body
############################################################

BEGIN_PGML
A line passes through the two given points. Find the line's equation in slope-intercept form.

[`[$p[0]]`] and [`[$p[1]]`]

[_]{$equation}{16}


END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
