DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

($m, $b) = random_subset(2, 2..9);
$m = Real(-$m);
$f = Formula("$b + $m x")->reduce;
Context("Point");
Context()->parens->set("[" => {type => "Interval", close => "]"});
Context()->parens->set("{" => {type => "Set", close => "}"});
Context()->parens->set("<" => {type => "Vector", close => ">"});
$yi = Point("(0,$b)");

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Find the line's slope and [`y`]-intercept.

END_PGML

######
# Body
######

BEGIN_PGML
[`y=[$f]`]

[@KeyboardInstructions('Enter the slope here.')@]**

[_]{$m}{5}

[@KeyboardInstructions('Enter the [`y`]-intercept here.')@]**

[_]{$yi}{5}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
