#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserNumberWithUnits.pl",
  "randomPerson.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

Context('Numeric');
$name = randomPerson();
$initial = random(12,17);
$rate = random(10,15);
$final = 100;
$solution = ($final - $initial)/$rate;
$time = NumberWithUnits("$solution min");

######
# Body
######

BEGIN_PGML
[$name] puts a pot of water from the tap onto the stove and turns the burner all the way up. The water temperature starts at [`[$initial]\,^{\circ}C`] and climbs steadily up to the boiling point of [`[$final]\,^{\circ}C\text{,}`] raising at a rate of [`[$rate]\,\frac{^{\circ}C}{\text{min}}\text{.}`] How long will it take for the pot to boil?

[_]{$time}{20}

END_PGML

