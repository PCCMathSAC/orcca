DOCUMENT();

#############
# Load Macros
#############

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "ORCCA.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

#######
# Setup
#######

$var = RandomVariableName();
Context()->variables->are($var => 'Real');
Context()->noreduce('(-x)-y', '(-x)+y');
$x = non_zero_random(-9, 9, 1);
$a = non_zero_random(-9, 9, 1);
$b = non_zero_random(-9, 9, 1);
$c = non_zero_random(-9, 9, 1);
$expression = Formula("$c abs($var + $a) + $b")->reduce;
$answer = $expression->eval($var => $x);
$answer = Real($answer);
Context("LimitedNumeric");
$answer = Real($answer);

#############################
# Exercise Group Introduction
#############################

BEGIN_PGML
Evaluate the expression for the given value of the variable.

END_PGML

######
# Body
######

BEGIN_PGML
[`[$expression]`] for [`[$var]=[$x]\text{.}`]

[_]{$answer}{15}

END_PGML

#############
# End Problem
#############

ENDDOCUMENT();
