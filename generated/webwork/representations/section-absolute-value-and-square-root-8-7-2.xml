    <statement><p>Evaluate the following.</p>
<p><m>\displaystyle{\sqrt{{{\frac{36}{121}}}}={}}</m><fillin characters="14" name="AnSwEr0001"/>.</p>
</statement>
    <answer>
      <p>
        <m>\frac{6}{11}</m>
      </p>
    </answer>
    <solution><p><m>\displaystyle{\begin{aligned}[t]
