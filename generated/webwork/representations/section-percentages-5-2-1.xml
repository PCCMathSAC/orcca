    <statement><p>Write the following decimals as percentages.</p>
<p><ol label="a.">
<li>
<p><m>\displaystyle{ 0.09 = }</m> <fillin characters="5" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>\displaystyle{ 0.9 = }</m> <fillin characters="5" name="AnSwEr0002"/></p>
</li>
<li>
<p><m>\displaystyle{ 9 = }</m> <fillin characters="5" name="AnSwEr0003"/></p>
</li>
<li>
<p><m>\displaystyle{ 1 = }</m> <fillin characters="5" name="AnSwEr0004"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>9.0\%</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>90.0\%</m>
      </p>
    </answer>
    <answer>
