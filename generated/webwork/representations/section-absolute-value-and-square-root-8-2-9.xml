    <statement><p>Evaluate the following.</p>
<p><ol label="a.">
<li>
<p><m>\displaystyle{ - \lvert 4-10 \rvert =  }</m>  <fillin characters="8" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>\displaystyle{ \lvert -4-10 \rvert =  }</m>  <fillin characters="8" name="AnSwEr0002"/></p>
</li>
<li>
<p><m>\displaystyle{ -4 \lvert 10-4 \rvert =  }</m>  <fillin characters="8" name="AnSwEr0003"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>-6</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>14</m>
