  <static seed="7" source="Contrib/PCC/BasicAlgebra/Exponents/ExponentDefinition10.pg">
    <statement><p>Evaluate the following.
<ol label="a.">
<li>
<p><m>5^{2}</m></p>
<p><fillin characters="8" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>4^{3}</m></p>
<p><fillin characters="8" name="AnSwEr0002"/></p>
</li>
<li>
<p><m>(-3)^{2}</m></p>
<p><fillin characters="8" name="AnSwEr0003"/></p>
</li>
<li>
<p><m>(-5)^{3}</m></p>
<p><fillin characters="8" name="AnSwEr0004"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>25</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>64</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>9</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-125</m>
      </p>
    </answer>
    <solution><p>The solutions are:</p>
<p><ol label="a.">
<li>
<p><m>\begin{aligned}[t]
             5^{2}\amp =5\cdot5\\
                     \amp ={25}  
          \end{aligned}</m></p>
</li>
<li>
<p><m>\begin{aligned}[t]
              4^{3}\amp =4\cdot4\cdot4\\
                      \amp ={64}
           \end{aligned}</m></p>
</li>
<li>
<p><m>\begin{aligned}[t] 
                 (-3)^{2}\amp =(-3)\cdot(-3)\\
                        \amp ={9}
            \end{aligned}</m></p>
</li>
<li>
<p><m>\begin{aligned}[t]
               (-5)^{3}\amp =(-5)\cdot(-5)\cdot(-5)\\
                         \amp ={-125}
           \end{aligned}</m></p>
</li>
</ol></p>
</solution>
