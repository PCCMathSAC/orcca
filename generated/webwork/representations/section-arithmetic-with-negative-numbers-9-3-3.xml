  <static seed="1750" source="Contrib/PCC/BasicAlgebra/SignedNumbersArithemtic/AddSubtractNegativeNumbers10.pg">
    <statement><p>Perform the given addition and subtraction.
<ol label="a.">
<li>
<p><m>{-12-8+\left(-7\right)}</m></p>
<p><fillin characters="8" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>{3-\left(-20\right)+\left(-10\right)}</m></p>
<p><fillin characters="8" name="AnSwEr0002"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>-27</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>13</m>
      </p>
    </answer>
    <solution><p>a.</p>
<p><m>\begin{aligned}
           {-12-8+\left(-7\right)} \amp  =-20+(-7)\\
                    \amp  =-20 - 7\\
                    \amp =-27 
        \end{aligned}</m></p>
<p>b.</p>
<p><m>\begin{aligned}
           {3-\left(-20\right)+\left(-10\right)} \amp  =3+20+(-10) \\
                    \amp  =23+(-10) \\
                     \amp  =23 - 10 \\
                    \amp =13 
       \end{aligned}</m></p>
</solution>
