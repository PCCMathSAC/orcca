  <static seed="1751" source="Contrib/PCC/BasicAlgebra/SignedNumbersArithemtic/AddSubtractNegativeNumbers10.pg">
    <statement><p>Perform the given addition and subtraction.
<ol label="a.">
<li>
<p><m>{-11-4+\left(-3\right)}</m></p>
<p><fillin characters="8" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>{10-\left(-20\right)+\left(-16\right)}</m></p>
<p><fillin characters="8" name="AnSwEr0002"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>-18</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>14</m>
      </p>
    </answer>
    <solution><p>a.</p>
<p><m>\begin{aligned}
           {-11-4+\left(-3\right)} \amp  =-15+(-3)\\
                    \amp  =-15 - 3\\
                    \amp =-18 
        \end{aligned}</m></p>
<p>b.</p>
<p><m>\begin{aligned}
           {10-\left(-20\right)+\left(-16\right)} \amp  =10+20+(-16) \\
                    \amp  =30+(-16) \\
                     \amp  =30 - 16 \\
                    \amp =14 
       \end{aligned}</m></p>
</solution>
