  <static seed="1945" source="Contrib/PCC/BasicAlgebra/RadicalsAndRationalExponents/EvaluateSquareRoot50.pg">
    <statement><p>Evaluate the following.</p>
<p><m>\displaystyle{-\sqrt{{{\frac{16}{49}}}}={}}</m><fillin characters="16" name="AnSwEr0001"/>.</p>
</statement>
    <answer>
      <p>
        <m>\frac{-4}{7}</m>
      </p>
    </answer>
    <solution><p><m>\displaystyle{ 
\begin{aligned}[t]
   -\sqrt{\frac{16}{49}} \amp = - \frac{\sqrt{16}}{\sqrt{49}} \\
                             \amp = - \frac{4}{7} 
\end{aligned}
    }</m></p>
</solution>
