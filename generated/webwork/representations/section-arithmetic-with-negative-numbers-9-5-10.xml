    <statement><p>Evaluate the following.
<ol label="a.">
<li>
<p><m>4^{2}</m></p>
<p><fillin characters="8" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>2^{3}</m></p>
<p><fillin characters="8" name="AnSwEr0002"/></p>
</li>
<li>
<p><m>(-4)^{2}</m></p>
<p><fillin characters="8" name="AnSwEr0003"/></p>
</li>
<li>
<p><m>(-3)^{3}</m></p>
<p><fillin characters="8" name="AnSwEr0004"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>16</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>8</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>16</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-27</m>
      </p>
    </answer>
    <solution><p>The solutions are:</p>
<p><ol label="a.">
<li>
<p><m>\begin{aligned}[t]
             4^{2}\amp =4\cdot4\\
                     \amp ={16}  
          \end{aligned}</m></p>
</li>
<li>
<p><m>\begin{aligned}[t]
              2^{3}\amp =2\cdot2\cdot2\\
                      \amp ={8}
           \end{aligned}</m></p>
</li>
<li>
<p><m>\begin{aligned}[t] 
                 (-4)^{2}\amp =(-4)\cdot(-4)\\
                        \amp ={16}
            \end{aligned}</m></p>
</li>
<li>
<p><m>\begin{aligned}[t]
               (-3)^{3}\amp =(-3)\cdot(-3)\cdot(-3)\\
                         \amp ={-27}
           \end{aligned}</m></p>
</li>
</ol></p>
</solution>
