  <static seed="1749" source="Contrib/PCC/BasicAlgebra/SignedNumbersArithemtic/AddSubtractNegativeNumbers10.pg">
    <statement><p>Perform the given addition and subtraction.
<ol label="a.">
<li>
<p><m>{-13-1+\left(-1\right)}</m></p>
<p><fillin characters="8" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>{6-\left(-19\right)+\left(-16\right)}</m></p>
<p><fillin characters="8" name="AnSwEr0002"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>-15</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>9</m>
      </p>
    </answer>
    <solution><p>a.</p>
<p><m>\begin{aligned}
           {-13-1+\left(-1\right)} \amp  =-14+(-1)\\
                    \amp  =-14 - 1\\
                    \amp =-15 
        \end{aligned}</m></p>
<p>b.</p>
<p><m>\begin{aligned}
           {6-\left(-19\right)+\left(-16\right)} \amp  =6+19+(-16) \\
                    \amp  =25+(-16) \\
                     \amp  =25 - 16 \\
                    \amp =9 
       \end{aligned}</m></p>
</solution>
