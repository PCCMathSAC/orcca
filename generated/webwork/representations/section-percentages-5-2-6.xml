    <statement><p>Write the following percentages as decimals.</p>
<p><ol label="a.">
<li>
<p><m>\displaystyle{ 535\% = }</m> <fillin characters="7" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>\displaystyle{ 53.5\% = }</m> <fillin characters="7" name="AnSwEr0002"/></p>
</li>
<li>
<p><m>\displaystyle{ 5.35\% = }</m> <fillin characters="7" name="AnSwEr0003"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>5.35</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>0.535</m>
      </p>
    </answer>
    <answer>
