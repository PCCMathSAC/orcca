        <exercise label="multivar-power-product-divided-by-power-product-frac-coef">
          <webwork xml:id="webwork-multivar-power-product-divided-by-power-product-frac-coef">
            <pg-code>
              $k = random(2, 9);
              @b = random_coprime([2..9], [2..9]);
              @b = map {$_ * $k} @b;
              Context("Fraction");
