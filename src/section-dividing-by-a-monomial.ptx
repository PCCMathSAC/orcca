      <exercisegroup cols="2">
        <title>Dividing Polynomials by Monomials</title>
        <introduction>
          <p>
            Simplify the expression.
          </p>
        </introduction>
        <exercise label="binomial-over-integer">
          <webwork xml:id="webwork-binomial-over-integer">
            <pg-code>
              $d = random(2, 9);
              @a = random_subset(2, 2 .. 9);
              @b = map {$_ * $d} @a;
              $x = list_random('a' .. 'k', 'm', 'n', 'p' .. 'r', 't' .. 'z');
              Context("Form")->variables->are($x => 'Real');
              @m = random_subset(2, 2 .. 9);
              $given = Formula("($b[0] $x^$m[0] + $b[1] $x^$m[1])/$d");
              $answer = Formula("$a[0] $x^$m[0] + $a[1] $x^$m[1]");
            </pg-code>
            <statement>
              <p>
                <m>\displaystyle<var name="$given"/></m>
              </p>
              <p>
                <var name="$answer" width="16"/>
              </p>
            </statement>
          </webwork>
        </exercise>
        <exercise label="binomial-over-integer-copy">
          <webwork copy="webwork-binomial-over-integer"/>
        </exercise>
        <exercise label="binomial-over-monomial">
          <webwork xml:id="webwork-binomial-over-monomial">
            <pg-code>
              $d = random(2, 9);
              @a = random_subset(2, 2 .. 9);
              @b = map {$_ * $d} @a;
              $x = list_random('a' .. 'k', 'm', 'n', 'p' .. 'r', 't' .. 'z');
              Context("Form")->variables->are($x => 'Real');
              @n = random_subset(2, 2 .. 9);
              $m = random(2,9);
              @m = map {$_ + $m} @n;
              $given = Formula("($b[0] $x^$m[0] + $b[1] $x^$m[1]) / ($d $x^$m)");
              $answer = Formula("$a[0] $x^$n[0] + $a[1] $x^$n[1]");
            </pg-code>
            <statement>
              <p>
                <m>\displaystyle<var name="$given"/></m>
              </p>
              <p>
                <var name="$answer" width="16"/>
              </p>
            </statement>
          </webwork>
        </exercise>
        <exercise label="binomial-over-monomial-copy">
          <webwork copy="webwork-binomial-over-monomial"/>
        </exercise>
        <exercise label="trinomial-over-power">
          <webwork xml:id="webwork-trinomial-over-power">
            <pg-code>
              $d = 1;
              @a = random_subset(3, -9 .. -2, 2 .. 9);
              @b = map {$_ * $d} @a;
              $x = list_random('a' .. 'k', 'm', 'n', 'p' .. 'r', 't' .. 'z');
              Context("Form")->variables->are($x => 'Real');
              Context()->noreduce('(-x)-y', '(-x)+y');
              @n = random_subset(3, 2 .. 9);
              $m = random(2, 9);
              @m = map {$_ + $m} @n;
              $given = Formula("($b[0] $x^$m[0] + $b[1] $x^$m[1] + $b[2] $x^$m[2]) / ($x^$m)")->reduce;
              $answer = Formula("$a[0] $x^$n[0] + $a[1] $x^$n[1] + $a[2] $x^$n[2]")->reduce;
            </pg-code>
            <statement>
              <p>
                <m>\displaystyle<var name="$given"/></m>
              </p>
              <p>
                <var name="$answer" width="16"/>
              </p>
            </statement>
            <solution>
              <p>
                We can divide <m><var name="$x"/>^{<var name="$m"/>}</m> into each of the three
                terms to get <m><var name="$answer"/></m>.
              </p>
            </solution>
          </webwork>
        </exercise>
        <exercise label="trinomial-over-power-copy">
          <webwork copy="webwork-trinomial-over-power"/>
        </exercise>
        <exercise label="trinomial-over-monomial">
          <webwork xml:id="webwork-trinomial-over-monomial">
            <pg-code>
              $d = random(2, 9);
              @a = random_subset(3, -9 .. -2, 2 .. 9);
              @b = map {$_ * $d} @a;
              $x = list_random('a' .. 'k', 'm', 'n', 'p' .. 'r', 't' .. 'z');
              Context("Form")->variables->are($x => 'Real');
              Context()->noreduce('(-x)-y', '(-x)+y');
              @n = random_subset(3, 2 .. 9);
              $m = random(2, 9);
              @m = map {$_ + $m} @n;
              $given = Formula("($b[0] $x^$m[0] + $b[1] $x^$m[1] + $b[2] $x^$m[2]) / ($d $x^$m)")->reduce;
              $answer = Formula("$a[0] $x^$n[0] + $a[1] $x^$n[1] + $a[2] $x^$n[2]");
            </pg-code>
            <statement>
              <p>
                <m>\displaystyle<var name="$given"/></m>
              </p>
              <p>
                <var name="$answer" width="16"/>
              </p>
            </statement>
          </webwork>
        </exercise>
        <exercise label="trinomial-over-monomial-copy">
          <webwork copy="webwork-trinomial-over-monomial"/>
        </exercise>
        <exercise label="binomial-over-linear-monomial">
          <webwork xml:id="webwork-binomial-over-linear-monomial">
            <pg-code>
              $d = random(2, 9);
              @a = random_subset(2, 2 .. 9);
              @b = map {$_ * $d} @a;
              $x = list_random('a' .. 'k', 'm', 'n', 'p' .. 'r', 't' .. 'z');
              Context("Form")->variables->are($x => 'Real');
              @n = random_subset(2, 2 .. 9);
              $m = 1;
              @m = map {$_ + $m} @n;
              $given = Formula("($b[0] $x^$m[0] - $b[1] $x^$m[1]) / ($d $x)");
              $answer = Formula("$a[0] $x^$n[0] - $a[1] $x^$n[1]");
            </pg-code>
            <statement>
              <p>
                <m>\displaystyle<var name="$given"/></m>
              </p>
              <p>
                <var name="$answer" width="16"/>
              </p>
            </statement>
          </webwork>
        </exercise>
        <exercise label="binomial-over-linear-monomial-copy">
          <webwork copy="webwork-binomial-over-linear-monomial"/>
        </exercise>
        <exercise label="binomial-over-monomial-multivar">
          <webwork xml:id="webwork-binomial-over-monomial-multivar">
            <pg-code>
              $d = random(2, 9);
              @a = random_subset(2, 2 .. 9);
              @b = map {$_ * $d} @a;
              ($x, $y) = random_subset(2, 'a' .. 'k', 'm', 'n', 'p' .. 'r', 't' .. 'z');
              Context("Form")->variables->are($x => 'Real', $y => 'Real');
              @n = random_subset(2, 2 .. 9);
              $m = random(2,9);
              @m = map {$_ + $m} @n;
              @p = random_subset(2, 2 .. 9);
              $q = random(2,9);
              @q = map {$_ + $q} @p;
              $given = Formula("($b[0] $x^$m[0] $y^$q[0] + $b[1] $x^$m[1] $y^$q[1]) / ($d $x^$m $y^$q)");
              $answer = Formula("$a[0] $x^$n[0] $y^$p[0] + $a[1] $x^$n[1] $y^$p[1]");
            </pg-code>
            <statement>
              <p>
                <m>\displaystyle<var name="$given"/></m>
              </p>
              <p>
                <var name="$answer" width="16"/>
              </p>
            </statement>
          </webwork>
        </exercise>
        <exercise label="binomial-over-monomial-multivar-copy">
          <webwork copy="webwork-binomial-over-monomial-multivar"/>
        </exercise>
      </exercisegroup>
    </subexercises>

    <subexercises>
      <title>Applications</title>
      <exercisegroup cols="2">
        <introduction>
          <p>
            A rectangular prism's base area can be calculated by the formula <m>B=\frac{V}{h}</m>,
            where <m>V</m> is the volume and <m>h</m> is the height.
          </p>
        </introduction>
        <exercise label="prism-base-area">
          <webwork xml:id="webwork-prism-base-area">
            <pg-code>
              Context("Numeric");
              Context()->noreduce('(-x)-y','(-x)+y');
              do {
                $d = random(2,5,1);
                $a = $d*random(2,10,1);
                $b = $d*random(2,10,1)*random(-1,1,2);
                $c = $d*random(2,10,1)*random(-1,1,2);
              } until ( ($a!=$b) &amp;&amp; ($a!=$c) &amp;&amp; ($b!=$c) );
              $exp3 = random(1,2,1);
              $exp2 = random($exp3+1,4,1);
              $exp1 = random($exp2+1,6,1);
              $v = Compute("$a*x**$exp1+$b*x**$exp2+$c*x**$exp3")->reduce;
              $h = Compute("$d*x")->reduce;
              $step1 = Compute("$a*x**$exp1/($d*x)+$b*x**$exp2/($d*x)+$c*x**$exp3/($d*x)")->reduce;
              $ad = $a/$d;
              $bd = $b/$d;
              $cd = $c/$d;
              $ans = Compute("$ad*x**($exp1-1)+$bd*x**($exp2-1)+$cd*x**($exp3-1)")->reduce;
              Context("LimitedPolynomial-Strict");
              $ans = Formula($ans);
            </pg-code>
            <statement>
              <p>
                A certain rectangular prism's volume can be modeled by <m><var name="$v"/></m> cubic
                units. If its height is <m><var name="$h"/></m> units, find the prism's base area.
              </p>
              <p>
                <var name="$ans" width="16"/>
              </p>
            </statement>
            <solution>
              <p>
                Using the formula,
                <me>B=\frac{<var name="$v"/>}{<var name="$h"/>}</me>
                Now we can divide <m><var name="$h"/></m> into each of the three terms in the
                numerator. So the base area is modeled by <m><var name="$ans"/></m>.
              </p>
            </solution>
          </webwork>
        </exercise>
        <exercise label="prism-base-area-copy">
          <webwork copy="webwork-prism-base-area"/>
        </exercise>
      </exercisegroup>
      <exercisegroup cols="2">
        <introduction>
          <p>
            A cylinder's height can be calculated by the formula <m>h=\frac{V}{B}</m>,
            where <m>V</m> is the volume and <m>B</m> is the base area.
          </p>
        </introduction>
        <exercise label="cylinder-base-area">
          <webwork xml:id="webwork-cylinder-base-area">
            <pg-code>
              Context("Numeric");
              Context()->noreduce('(-x)-y','(-x)+y');
              do {
                 $d = random(2,5,1);
                 $a = $d*random(2,10,1);
                 $b = $d*random(2,10,1)*random(-1,1,2);
                 $c = $d*random(2,10,1)*random(-1,1,2);
              } until ( ($a!=$b) &amp;&amp; ($a!=$c) &amp;&amp; ($b!=$c) );
              $exp3 = random(2,3,1);
              $exp2 = random($exp3+1,5,1);
              $exp1 = random($exp2+1,7,1);
              $v = Compute("$a*pi*x**$exp1+$b*pi*x**$exp2+$c*pi*x**$exp3")->reduce;
              $B = Compute("$d*pi*x**2")->reduce;
              $step1 = Compute("$a*pi*x**$exp1/($d*pi*x**2)+$b*pi*x**$exp2/($d*pi*x**2)+$c*pi*x**$exp3/($d*pi*x**2)")->reduce;
              $ad = $a/$d;
              $bd = $b/$d;
              $cd = $c/$d;
              $ans = Compute("$ad*x**($exp1-2)+$bd*x**($exp2-2)+$cd*x**($exp3-2)")->reduce;
              Context("LimitedPolynomial-Strict");
              $ans = Formula($ans);
            </pg-code>
            <statement>
              <p>
                A certain cylinder's volume can be modeled by <m><var name="$v"/></m> cubic units.
                If its base area is <m><var name="$B"/></m> square units, find the cylinder's
                height.
              </p>
              <p>
                <var name="$h" width="16"/>
              </p>
            </statement>
          </webwork>
        </exercise>
        <exercise label="cylinder-base-area-copy">
          <webwork copy="webwork-cylinder-base-area"/>
        </exercise>
      </exercisegroup>
    </subexercises>
  </exercises>
</section>

