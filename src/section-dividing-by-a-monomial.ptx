        <exercise label="integer-power-divided-by-power">
          <webwork xml:id="webwork-integer-power-divided-by-power">
            <pg-code>
              $x = random(100,200);
              Context("Form");
              @m = random_subset(2, 200 .. 300);
              push @m, $m[0] + $m[1];
              $given = Formula("$x^$m[2]/$x^$m[1]");
              $answer = Formula("$x^$m[0]");
            </pg-code>
            <statement>
              <p>
                <m>\displaystyle<var name="$given"/></m>
              </p>
              <p>
