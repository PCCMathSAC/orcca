              push @m, $m[0] + $m[1], $m[2] + $m[3];
              $given = Formula("($x^$m[4] $y^$m[5])/($x^$m[1] $y^$m[3])");
              $answer = Formula("$x^$m[0] $y^$m[2]");
            </pg-code>
